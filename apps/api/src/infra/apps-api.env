# --- Base de datos (debe coincidir con docker-compose.yml de la raíz) ---
DATABASE_URL="postgresql://saas_user:saas_password@localhost:5432/saas_ai_commerce?schema=public"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- MinIO (S3 compatible) ---
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minio_admin"
S3_SECRET_KEY="minio_password"
S3_BUCKET="saas-ai-commerce"
S3_REGION="us-east-1"

# --- JWT ---
JWT_SECRET="cambiar-este-valor-en-produccion"
JWT_REFRESH_SECRET="cambiar-este-otro-valor-en-produccion"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- OpenAI ---
OPENAI_API_KEY="sk-..."

# --- App ---
PORT=3000
NODE_ENV=development